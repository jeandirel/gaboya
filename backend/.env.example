# Server-only configuration. Generate APP_SECRET locally; never commit it.
APP_ENV=development
APP_SECRET=
DATABASE_URL=
# Direct Neon URL for Alembic; pooled DATABASE_URL for normal API traffic.
DATABASE_URL_UNPOOLED=
CORS_ORIGINS=
SMS_PROVIDER=disabled
# Real SMS: configure only after provider account/delivery approval.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
PAWAPAY_MODE=disabled
# Test only: APP_ENV=test + ALLOW_TEST_SMS=1 + local PostgreSQL database *_test.
# SMS_PROVIDER=test
# ALLOW_TEST_SMS=1
# TEST_SMS_DIR=.otp-inbox
